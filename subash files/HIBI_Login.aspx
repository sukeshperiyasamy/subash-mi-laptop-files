    <script language="javascript" type="text/javascript">
        function toASCII(source, args) {

            var r1 = 0, r2 = 0;
            for (var i = 0; i < args.Value.length; i++) {
                r = args.Value.charCodeAt(i);
                if ((r >= 32 && r <= 127) || r == 8 || r == 9 || r == 13 || r == 10) {
                    r1 = 1;
                }
                else {
                    r2 = 1;
                    break;
                }
            }
            if (r2 > 0) {
                args.IsValid = false;
                return false;
            }
            else {
                args.IsValid = true;
                return true;
            }
        }
    </script>
